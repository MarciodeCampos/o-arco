{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(//**/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/hosts.yml)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push -f *)",
      "Bash(git push *+*)",
      "Bash(git -C * push *--force*)",
      "Bash(gh repo delete *)",
      "Bash(terraform destroy *)"
    ]
  }
}
